# এই file-এর নাম বদলে .env করুন এবং নিজের মান বসান। .env কখনো GitHub-এ যাবে না।
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string। শেষে database নাম doctor_tracker থাকতে হবে।
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# Frontend-এর address (একাধিক হলে কমা দিয়ে আলাদা করুন)
CLIENT_ORIGIN=http://localhost:3000

# Login টিকিটের গোপন চাবি (কমপক্ষে ৩২ অক্ষর, এলোমেলো)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Cookie সেটিং: একই site-এর জন্য lax
COOKIE_SAMESITE=lax

# প্রথমবার admin তৈরির জন্য (password কমপক্ষে ১২ অক্ষর)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
