NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string। শেষে database নাম doctor_tracker থাকতে হবে।
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/doctor_tracker?retryWrites=true&w=majority

# Frontend-এর ঠিকানা (একাধিক হলে কমা দিয়ে আলাদা করুন)
CLIENT_ORIGIN=http://localhost:3000

# Login টিকিটের গোপন চাবি: কমপক্ষে ৩২ অক্ষর, এলোমেলো
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# Cookie সেটিং: Frontend ও API একই site (যেমন *.bizvely.com) হলে lax
COOKIE_SAMESITE=lax

# প্রথমবার server চালু হলে এই admin তৈরি হয় (password কমপক্ষে ১২ অক্ষর)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ঐচ্ছিক: reviewer/interviewer-দের জন্য আলাদা demo account (দুটোই দিলে তৈরি হয়, password কমপক্ষে ১২ অক্ষর)
# এই account-এর password অ্যাপ থেকে বদলানো যায় না
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-a-demo-password
